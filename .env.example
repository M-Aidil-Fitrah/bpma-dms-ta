APP_NAME="BPMA DMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL/MariaDB WAJIB — index FULLTEXT untuk pencarian isi dokumen (FR-34)
# tidak didukung SQLite. Migration akan gagal kalau ini diubah ke sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpma-dms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- BPMA DMS ---------------------------------------------------------------
# Akun Superadmin. Kredensial HANYA hidup di berkas ini — tidak pernah ditulis
# sebagai nilai literal di seeder maupun kode.
SUPERADMIN_NAME="Administrator BPMA"
SUPERADMIN_EMAIL=superadmin@bpma.internal
SUPERADMIN_PASSWORD=

# Masa berlaku cookie "Ingat saya" dalam menit (43200 = 30 hari).
AUTH_REMEMBER_DURATION=43200
# Masa konfirmasi ulang kata sandi untuk aksi sensitif dalam detik (900 = 15 menit).
AUTH_PASSWORD_TIMEOUT=900