APP_NAME="BPMA DMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dms.example.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL/MariaDB wajib untuk index FULLTEXT. Pakai akun aplikasi khusus,
# bukan root; isi DB_PASSWORD melalui secret manager atau environment host.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bpma-dms
DB_USERNAME=bpma_dms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Harus melebihi timeout job terpanjang (OCR default 900 detik).
DB_QUEUE_RETRY_AFTER=1200

# Store database menyediakan cache lock bersama untuk job unik. Gunakan Redis
# setelah tersedia; jangan gunakan driver array pada worker produksi.
CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.go.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Wajib diisi dari secret manager. Password Superadmin minimal 16 karakter.
SUPERADMIN_NAME="Administrator BPMA"
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

AUTH_REMEMBER_DURATION=43200
AUTH_PASSWORD_TIMEOUT=900
