# Batas ukuran unggahan untuk lingkungan Apache.
#
# Harus selaras dengan `ukuran_maksimum_kb` di config/dms.php.
# Lingkungan PHP-FPM/CGI diatur lewat public/.user.ini, bukan di sini.

# Berlaku di semua modus Apache. Nilai dalam byte: 1074 MB.
# Tanpa ini, Apache menolak permintaan besar dengan 413 sebelum PHP dijalankan.
LimitRequestBody 1126170624

# Hanya untuk Apache dengan mod_php. Pembungkus IfModule wajib: pada PHP-FPM,
# direktif php_value tidak dikenali dan membuat seluruh situs balas 500.
<IfModule mod_php.c>
    php_value upload_max_filesize 1024M
    php_value post_max_size 1074M
    php_value memory_limit 512M
    php_value max_execution_time 0
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
